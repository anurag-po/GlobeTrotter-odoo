{
  "name": "globetrotter-backend",
  "version": "1.0.0",
  "description": "GlobeTrotter multi-city collaborative trip-planning platform backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
